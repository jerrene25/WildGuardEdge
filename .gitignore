# ========================================================
# WildGuard Edge - Production Git Ignore Configuration
# ========================================================

# Virtual Environment
venv/
env/
ENV/
.venv/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# C extensions
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# SQLite Database & Incident History
alerts/*.db
alerts/*.sqlite
alerts/*.sqlite3
alerts/*.db-journal
alerts/*.json

# Snapshot Images (Privacy & Storage)
alerts/snapshots/*
!alerts/snapshots/.gitkeep

# Datasets & Temporary Training Audio
training/esc50_data/
retraining_data/*
!retraining_data/.gitkeep

# Backup Weights & Logs
modules/*_old.pth
*.log
logs/

# Secrets & Local Configurations
.env
.env.local
.env.*.local

# Operating System & IDE Artifacts
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
