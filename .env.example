# WildGuardEdge - Environment Configuration Template
# Copy this file to .env and customize values for production deployment.

# Execution Environment: development | production | testing
WILDGUARD_ENV=production

# Compute Device: cuda | cpu (auto-detected if omitted)
# WILDGUARD_DEVICE=cuda

# Hardware Interfaces
WILDGUARD_CAMERA_INDEX=0
# Optional Hardware Microphone Device Index
# WILDGUARD_MIC_INDEX=1

# Storage Paths (relative to project root or absolute)
# WILDGUARD_DB_PATH=alerts/wildguard.db
# WILDGUARD_SNAPSHOT_DIR=alerts/snapshots

# Acoustic Sensitivity Thresholds
WILDGUARD_AUDIO_RMS_FLOOR=0.0002
WILDGUARD_AUDIO_THREAT_THRESHOLD=0.60

# Visual Detector Confidence Threshold (0.05 to 0.95)
WILDGUARD_YOLO_CONF_THRESHOLD=0.45

# Vision-Language (CLIP) Threat Threshold (0.10 to 0.90)
WILDGUARD_CLIP_THREAT_THRESHOLD=0.28

# Multimodal Fusion Thresholds
WILDGUARD_DAY_FUSION_THRESHOLD=0.55
WILDGUARD_NIGHT_FUSION_THRESHOLD=0.45

# Day/Night Schedule (24-hour clock)
WILDGUARD_NIGHT_START_HOUR=20
WILDGUARD_NIGHT_END_HOUR=6

